# Dashboard app secret (sessions + token encryption). Change in real deployments.
SECRET_KEY=change-me-in-production-use-a-long-random-string

# SQLite by default (file created under ./data/)
# DATABASE_URL=sqlite:///D:/Akash/replicon_automation/data/replicon_dashboard.db

APP_NAME=Replicon Timesheet Dashboard

